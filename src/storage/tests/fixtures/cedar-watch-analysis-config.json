  "components": {
    "practice": {
      "type": "questionnaire",
      "instruction": "Practice · not an experimental trial. This separate fictional example is for learning the controls. It is not one of the Cedar Watch trial scenarios. This synthetic preview does not request or record research consent. The host records the practice answer as a practice response, separate from the ten trial responses.",
      "response": [
        {
          "id": "practice-evidence",
          "type": "textOnly",
          "location": "aboveStimulus",
          "prompt": "**Fictional Harbor Lane practice reports**\n\n| Report | Observed | Received | Reported count |\n| --- | --- | --- | --- |\n| Practice log A | 09:00 | 09:12 | Not recorded |\n| Practice log B | 09:10 | 09:42 | About 3 |\n\nIn the practice display, a count that is not recorded is unknown—not zero. Observation and receipt times describe different events. Reports can overlap and should not be added into a total."
        },
        {
          "id": "practice-understanding",
          "type": "radio",
          "location": "sidebar",
          "prompt": "Does “not recorded” mean the source reported zero?",
          "options": [
            "Yes",
            "No"
          ]
        }
      ],
      "correctAnswer": [
        {
          "id": "practice-understanding",
          "answer": "No"
        }
      ],
      "provideFeedback": true,
      "trainingAttempts": 1,
      "allowFailedTraining": true,
      "instructionLocation": "aboveStimulus",
      "nextButtonLocation": "belowStimulus",
      "nextButtonText": "Continue synthetic preview"
    },
